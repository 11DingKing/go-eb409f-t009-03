# Ejina microgrid dispatch center — example configuration.
# All values are optional; defaults are shown.

# Listen address (host:port).
EJINA_ADDR=:51523

# Snapshot file path for durable state recovery.
EJINA_DATA=./data/ejinagrid.json

# Daily cabin-inspection window (local hours, half-open [start, end)).
EJINA_INSPECTION_WINDOW_START=8
EJINA_INSPECTION_WINDOW_END=10

# Background worker tick interval (seconds) for escalation, retest prep, snapshot.
EJINA_TICK_SECONDS=30
